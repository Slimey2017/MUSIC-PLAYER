  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "0.24.1",
    "@supabase/supabase-js": "2.111.0",
    "cors": "2.8.6",
    "express": "4.22.1",
    "multer": "2.2.0"
  }
}
